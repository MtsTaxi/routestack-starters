# Restrict HTTP methods — only allow POST (and OPTIONS for preflight)
<LimitExcept POST OPTIONS>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</LimitExcept>

# Disable directory listing
Options -Indexes

# Block PHP fatal-error output from leaking into JSON responses
php_flag display_errors Off
php_flag log_errors On

# Security headers
Header always set X-Content-Type-Options nosniff
Header always set X-Frame-Options DENY
