# RouteStack — Required
ROUTESTACK_API_KEY=your-routestack-api-key
ROUTESTACK_API_SECRET=your-routestack-api-secret
ROUTESTACK_MCP_URL=https://mcp.routestack.ai/sse

# Bridge authentication — generate with: openssl rand -hex 32
# This value must also be set in your PHP private-config/routestack.php
BRIDGE_SECRET=replace-with-a-random-64-char-hex-string

# Server (127.0.0.1 keeps the bridge private — never change HOST to 0.0.0.0)
HOST=127.0.0.1
PORT=3001

# Per-request timeout in milliseconds (keep below Cloudflare's 100 s limit)
REQUEST_TIMEOUT_MS=25000
